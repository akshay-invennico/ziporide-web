    "lucide-react": "^0.577.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
